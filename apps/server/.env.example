# Run `pnpm setup:local` from the repository root to generate this key.
ENCRYPTION_KEY=
# Relative to apps/server. This directory belongs only to SocialDesk.
DATA_DIR=../../data
HOST=127.0.0.1
PORT=3002
APP_ORIGIN=http://127.0.0.1:5174
# Must exactly match each developer app's authorized redirect URI.
# Use your tunnel origin here if the provider requires HTTPS callbacks.
OAUTH_ORIGIN=http://127.0.0.1:3002
# HTTPS tunnel origin, forwarded to port 3002, with Host header preserved.
PUBLIC_MEDIA_ORIGIN=
MAX_UPLOAD_BYTES=536870912
# Set to a version supported by your existing Meta apps.
META_GRAPH_VERSION=v25.0
# One Facebook Login app for Facebook Pages and linked Instagram Business/Creator accounts.
# Register /public/oauth/meta/callback under OAUTH_ORIGIN.
META_APP_ID=
META_APP_SECRET=
# Compatibility fallback when BOTH META_APP_* values are unset.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Only for reconnecting existing direct Instagram Login authorizations.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
